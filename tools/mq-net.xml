<network>
  <!-- ticket 05: one NAT network for all qubes (owner one-time setup in README).
       10.137.0.0/24 is Qubes' own subnet — an homage, and a reminder of the
       isolation rule in mq-isolate.nwfilter. -->
  <name>mq-net</name>
  <forward mode='nat'/>
  <ip address='10.137.0.1' netmask='255.255.255.0'>
    <dhcp>
      <range start='10.137.0.2' end='10.137.0.254'/>
    </dhcp>
  </ip>
</network>
